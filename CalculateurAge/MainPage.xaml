<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge.MainPage"
             Title="Calculateur">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Nom" FontSize="16"/>
            <Entry Text="{Binding Nom, Mode=TwoWay}" Placeholder="Votre nom"/>
            <Label Text="Date de naissance" FontSize="16"/>
            <DatePicker Date="{Binding DateNaissance, Mode=TwoWay}"
                        MaximumDate="{Binding DateMaximale}"/>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Calculer" Command="{Binding CalculerCommand}"/>
                <Button Grid.Column="1" Text="Effacer" Command="{Binding EffacerCommand}"/>
            </Grid>
            <VerticalStackLayout Spacing="6" IsVisible="{Binding ResultatVisible}">
                <Label Text="{Binding Resultat}" FontSize="20"/>
                <Label Text="{Binding Statut}" FontSize="16" FontAttributes="Bold"/>
                <Label Text="{Binding ProchainAnniversaire}" FontSize="16"/>
                <Button Text="Voir le détail" Command="{Binding VoirDetailCommand}"/>
            </VerticalStackLayout>

            <!-- Historique : BindableLayout plutôt que CollectionView,
                 qui se comporte mal à l'intérieur d'un ScrollView. -->
            <VerticalStackLayout Spacing="6" Margin="0,16,0,0"
                                 IsVisible="{Binding HistoriqueVisible}">
                <Label Text="Historique" FontSize="18" FontAttributes="Bold"/>
                <VerticalStackLayout Spacing="4"
                                     BindableLayout.ItemsSource="{Binding Historique}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Label Text="{Binding Resume}" FontSize="14"/>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Button Text="Vider l'historique" Command="{Binding ViderHistoriqueCommand}"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
